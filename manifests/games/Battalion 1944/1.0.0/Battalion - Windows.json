        "identifier": "b0534444-f440-4903-9c9b-18988e5ec753"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeServiceStopped"
        ],
        "name": "Graceful stop via Ctrl+C (windows-kill)",
        "description": "Global graceful stop: on BeforeServiceStopped sends Ctrl+C (SIGINT) to the game process via windows-kill.exe (auto-downloaded to the hidden .tca folder). Windows-only; skips non-game services.",
        "code": "//refAssemblies: TCAdmin.SDK.dll, TCAdmin.GameHosting.SDK.dll, TCAdmin.Scripting.dll, TCAdmin.Monitor.dll, TCAdmin.Web.Shared.dll, System.Net.Http.dll, System.IO.Compression.dll, System.IO.Compression.ZipFile.dll, System.Diagnostics.Process.dll\nusing System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Net.Http;\nusing System.Threading;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Global graceful-stop helper (Windows). On BeforeServiceStopped, send Ctrl+C (SIGINT)\n// to the running game-server process via windows-kill.exe so it shuts down cleanly before\n// TCAdmin performs its own stop. windows-kill.exe is downloaded on demand into the hidden\n// {serviceroot}/.tca folder (so the customer never sees it) and reused on later stops.\n\n// Only game services expose a single tracked process id; skip anything else (Docker/base).\nvar gameService = (object)ThisService as GameService;\nif (gameService == null)\n{\n    ScriptConsole.WriteLine(\"Not a game service; skipping graceful Ctrl+C stop.\");\n    return;\n}\n\nint? pid = gameService.ProcessId;\nif (pid == null || pid <= 0)\n{\n    ScriptConsole.WriteLine(\"No running process id for this service; nothing to stop.\");\n    return;\n}\n\n// Keep windows-kill.exe in the hidden .tca folder so it isn't visible to the user.\nstring toolDir = Path.Combine(RootDirectory, \".tca\");\nstring killExe = Path.Combine(toolDir, \"windows-kill.exe\");\n\n// Download windows-kill.exe on demand if it isn't cached yet.\nif (!File.Exists(killExe))\n{\n    const string url = \"https://github.com/ElyDotDev/windows-kill/releases/download/1.1.4/windows-kill_1.1.4_release.zip\";\n    const string entryPath = \"windows-kill_x64_1.1.4_lib_release/windows-kill.exe\";\n\n    try\n    {\n        Directory.CreateDirectory(toolDir);\n        string zipPath = Path.Combine(toolDir, \"windows-kill_1.1.4_release.zip\");\n\n        ScriptConsole.WriteLine($\"windows-kill.exe not found; downloading {url}\");\n        using (var http = new HttpClient())\n        {\n            byte[] data = await http.GetByteArrayAsync(url, ThisCancellationToken);\n            await File.WriteAllBytesAsync(zipPath, data, ThisCancellationToken);\n        }\n\n        using (ZipArchive archive = ZipFile.OpenRead(zipPath))\n        {\n            ZipArchiveEntry entry = archive.GetEntry(entryPath);\n            if (entry == null)\n                throw new Exception($\"Entry '{entryPath}' not found in the archive.\");\n            entry.ExtractToFile(killExe, overwrite: true);\n        }\n        ScriptConsole.WriteLine($\"Extracted windows-kill.exe to {killExe}\");\n\n        try { File.Delete(zipPath); }\n        catch (Exception ex) { ScriptConsole.WriteLine($\"Warning: could not delete zip file: {ex.Message}\"); }\n    }\n    catch (Exception ex)\n    {\n        ScriptConsole.WriteLine($\"Failed to download windows-kill.exe: {ex.Message}; skipping graceful Ctrl+C stop.\");\n        return;\n    }\n}\n\n// Send Ctrl+C (SIGINT) to the running game process.\nScriptConsole.WriteLine($\"Sending SIGINT (Ctrl+C) to process {pid} via windows-kill.exe\");\nvar psi = new ProcessStartInfo\n{\n    FileName = killExe,\n    Arguments = $\"-SIGINT {pid}\",\n    WorkingDirectory = RootDirectory,\n    UseShellExecute = false,\n    CreateNoWindow = true,\n    RedirectStandardOutput = true,\n    RedirectStandardError = true\n};\n\ntry\n{\n    using var killer = Process.Start(psi);\n    if (killer != null)\n        await killer.WaitForExitAsync(ThisCancellationToken);\n}\ncatch (Exception ex)\n{\n    ScriptConsole.WriteLine($\"Failed to run windows-kill.exe: {ex.Message}\");\n    return;\n}\n\n// Wait up to 60s for the process to exit before TCAdmin proceeds with its own stop.\nconst int maxChecks = 60;\nfor (int count = 1; count <= maxChecks; count++)\n{\n    bool running;\n    try\n    {\n        using var proc = Process.GetProcessById(pid.Value);\n        running = !proc.HasExited;\n    }\n    catch (ArgumentException)\n    {\n        running = false; // process no longer exists\n    }\n\n    if (!running)\n    {\n        ScriptConsole.WriteLine($\"Process {pid} has exited after {count} second(s).\");\n        return;\n    }\n\n    await Task.Delay(TimeSpan.FromSeconds(1), ThisCancellationToken);\n}\n\nScriptConsole.WriteLine($\"WARNING: process {pid} did not exit within {maxChecks} seconds.\");\n",
        "runImpersonated": true,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
