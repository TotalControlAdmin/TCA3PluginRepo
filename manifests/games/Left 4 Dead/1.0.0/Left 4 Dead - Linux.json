  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Prepare the server",
        "description": "Writes steam_appid.txt so the first start connects to Steam (otherwise LAN only) and keeps the previous console log as console.previous.log.",
        "code": "using System;\nusing System.IO;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\nvar root = (string)ThisService.RootDirectory;\n\n// srcds writes steam_appid.txt next to itself, but only during its first run, which therefore starts without Steam\n// (\u0022Unable to load Steam support library ... LAN mode only\u0022). Writing it before every start makes the first one work.\nvar appIdFile = Path.Combine(root, \u0022steam_appid.txt\u0022);\nif (!File.Exists(appIdFile) || File.ReadAllText(appIdFile).Trim(\u0027\\0\u0027, \u0027\\r\u0027, \u0027\\n\u0027, \u0027 \u0027) != \u0022500\u0022)\n{\n    File.WriteAllText(appIdFile, \u0022500\\n\u0022);\n    ScriptConsole.WriteLine((object)\u0022Wrote steam_appid.txt (500).\u0022);\n}\n// Scripts run as root on Linux: give the file to the service user (same owner as the service root), otherwise the\n// file manager hides it.\nif (System.OperatingSystem.IsLinux())\n{\n    Globals.OperatingSystem.SetFileOwnerAutoDetect(appIdFile);\n}\n\n// -condebug appends to console.log forever; keep only the previous run next to the new one.\nvar log = Path.Combine(root, \u0022left4dead\u0022, \u0022console.log\u0022);\nif (File.Exists(log))\n{\n    File.Move(log, Path.Combine(Path.GetDirectoryName(log), \u0022console.previous.log\u0022), true);\n}\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "f09dcea1-97ce-4827-a5dd-67f127c02f46"
      }
    }
  ],
