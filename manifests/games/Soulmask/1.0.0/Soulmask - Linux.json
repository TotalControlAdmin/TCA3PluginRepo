          "Linux"
        ],
        "scriptEvents": [
          "AfterCustomModInstalled"
        ],
        "name": "Add the Workshop mod to the mod list",
        "description": "Add the Workshop mod to the mod list",
        "code": "//refAssemblies: TCAdmin.Web.Shared.dll\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Threading.Tasks;\r\nusing Microsoft.EntityFrameworkCore;\r\nusing TCAdmin.Web.Shared.Models;\r\n\r\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\r\n\r\n// Soulmask loads the Workshop items listed in -mod=\"id1,id2\" (the Mods variable). Add this item to the\r\n// list and re-derive the command line; the server picks it up the next time it starts.\r\nstring fileId = Convert.ToString(Dynamic.FileId).Trim();\r\n\r\nvar service = await GameServiceManager.GetAsync(ThisService.ServiceId);\r\nvar current = service.Variables ?? new TCAdminVars();\r\nvar mods = current.Parse<string>(\"Mods\", string.Empty)\r\n    .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)\r\n    .Select(x => x.Trim()).Where(x => x.Length > 0).ToList();\r\n\r\nif (mods.Contains(fileId))\r\n{\r\n    ScriptConsole.WriteLine((object)$\"Workshop item {fileId} is already in the mod list.\");\r\n}\r\nelse\r\n{\r\n    mods.Add(fileId);\r\n    var updated = new TCAdminVars();\r\n    foreach (var pair in current) updated[pair.Key] = pair.Value;\r\n    updated[\"Mods\"] = string.Join(\",\", mods);\r\n    service.Variables = updated;\r\n    GameServiceManager.TCAdminDbContext.Entry(service).State = EntityState.Modified;\r\n    await GameServiceManager.SaveChangesAsync(ThisCancellationToken);\r\n    ScriptConsole.WriteLine((object)(\"Mods=\" + updated[\"Mods\"]));\r\n}\r\n\r\nvar refresh = await ServiceManager.RefreshActiveCommandLine(null, ThisService.ServiceId);\r\nScriptConsole.WriteLine((object)(string.IsNullOrEmpty(refresh.Error) ? \"Command line updated.\" : \"Command line not updated: \" + refresh.Error));\r\nScriptConsole.WriteLine((object)\"The mod is loaded the next time the server starts.\");\r\n",
