    "glassCardBackground": "rgba(14,22,20,0.82)",
    "progressBarColor": "#00c48a",
    "customCss": "/* VIRIDIAN \u2014 Marquee pre-Blazor boot loader (theme.loadingScreen.customCss, NOT the layout\n   template). Single-sourced here; push-palette-local.ps1 pushes it live.\n   Dark scheme only \u2014 App.razor drops CustomCss in light mode, so light keeps the app.css default.\n\n   This is the ONE sheet the recolour contract in Classic\u0027s base.css cannot reach: the loading\n   screen paints before the layout template\u0027s stylesheet exists, so it carries its own copy of\n   the ramp. Keep it in sync with base-extra.css by hand.\n   Metaphor is VIRIDIAN\u0027s, not MOLTEN\u0027s: the house lights come up on a marquee (Bebas Neue caps),\n   it is not a forge catching. Same 4.2s timing as MOLTEN\u0027s ramp \u2014 that part is proven. */\n@import url(\u0027https://fonts.googleapis.com/css2?family=Bebas\u002BNeue\u0026display=swap\u0027);\n#tcadmin-loading .loading-bg-image{background:radial-gradient(1000px 600px at 10% 112%,rgba(0,214,150,.26),transparent 62%),radial-gradient(700px 400px at 90% -10%,rgba(217,138,75,.09),transparent 55%),linear-gradient(160deg,#0e1614 0%,#0a0f0d 55%,#060b09 100%)!important;background-color:#0a0f0d!important}\n#tcadmin-loading .loading-glass-card{border:1px solid rgba(0,196,138,.28);border-radius:20px;box-shadow:0 0 40px rgba(0,196,138,.16),inset 0 1px 0 rgba(255,255,255,.07);position:relative;overflow:hidden}\n#tcadmin-loading .loading-glass-card::after{content:\u0022\u0022;position:absolute;left:8%;right:8%;bottom:0;height:2px;background:linear-gradient(90deg,transparent,#12cf95 20%,#c8f7e4 50%,#00c48a 80%,transparent);background-size:220% 100%;box-shadow:0 0 16px rgba(0,196,138,.7)}\n/* Bebas Neue ships one weight \u2014 the condensed caps do the work, font-weight would be a no-op. */\n#tcadmin-loading .loading-brand-title{font-family:\u0027Bebas Neue\u0027,sans-serif;letter-spacing:.28em;text-transform:uppercase;font-weight:400}\n\n/* ---- house lights ----\n   The marquee lights come up while the app boots: everything starts dark and unlit and rises to\n   full. Same story the running panel tells with --tca-cool, just on a timer \u2014 the loader has no\n   service state to read. \u0060both\u0060 holds the lit end when boot outlasts the ramp; the seam keeps its\n   flow loop and gains a fade-in as a second animation. */\n#tcadmin-loading .loading-bg-image{animation:mq-lights-bg 4.2s ease-out both}\n#tcadmin-loading .loading-glass-card{animation:mq-lights-card 4.2s ease-out both}\n#tcadmin-loading .loading-brand-title{animation:mq-lights-title 4.2s ease-out both}\n#tcadmin-loading .loading-glass-card::after{animation:mq-lights-flow 7s linear infinite,mq-lights-seam 4.2s ease-out both}\n#tcadmin-loading .loading-progress-fill{animation:mq-lights-fill 4.2s ease-out both}\n#tcadmin-loading .loading-status{animation:mq-lights-status 4.2s ease-out both}\n\n@keyframes mq-lights-flow{0%{background-position:0% 0}100%{background-position:220% 0}}\n@keyframes mq-lights-bg{\n  0%{filter:saturate(.1) brightness(.6)}\n  45%{filter:saturate(.55) brightness(.85)}\n  100%{filter:saturate(1) brightness(1)}}\n@keyframes mq-lights-card{\n  0%{border-color:rgba(120,132,148,.2);box-shadow:0 0 0 rgba(0,196,138,0),inset 0 1px 0 rgba(255,255,255,.03)}\n  100%{border-color:rgba(0,196,138,.28);box-shadow:0 0 40px rgba(0,196,138,.16),inset 0 1px 0 rgba(255,255,255,.07)}}\n/* Unlit -\u003E full -\u003E settled: the overshoot at 60% is what sells \u0022the sign just came on\u0022. */\n@keyframes mq-lights-title{\n  0%{color:#5a6b66;text-shadow:none}\n  60%{color:#00c48a;text-shadow:0 0 28px rgba(0,196,138,.6)}\n  100%{color:var(--text-color,#eef5f2);text-shadow:0 0 18px rgba(0,196,138,.38)}}\n@keyframes mq-lights-seam{0%{opacity:0;filter:saturate(.1)}30%{opacity:.28}100%{opacity:1;filter:saturate(1)}}\n@keyframes mq-lights-fill{\n  0%{filter:saturate(.12) brightness(.65);box-shadow:none}\n  100%{filter:saturate(1) brightness(1);box-shadow:0 0 14px rgba(0,196,138,.55)}}\n@keyframes mq-lights-status{0%{opacity:.35}100%{opacity:1}}\n\n/* Reduced motion: no ramp, no flow \u2014 \u0060both\u0060 means the elements simply render their lit end. */\n@media (prefers-reduced-motion:reduce){\n  #tcadmin-loading .loading-bg-image,#tcadmin-loading .loading-glass-card,\n  #tcadmin-loading .loading-brand-title,#tcadmin-loading .loading-glass-card::after,\n  #tcadmin-loading .loading-progress-fill,#tcadmin-loading .loading-status{animation:none}\n}\n"
  },
  "createdDate": "0001-01-01T00:00:00"
}