    {
      "id": 91,
      "relativePath": "tf\\cfg\\server.cfg",
      "description": "Main server settings",
      "template": "// Managed by TCAdmin. Settings edited in the panel overwrite this file.\n// Put your own extra commands in custom.cfg (executed at the end).\n\n// ---- Identity ----\nhostname \u0022${Hostname}\u0022\nrcon_password \u0022${RconPassword}\u0022\nsv_password \u0022${PrivatePassword}\u0022\nsv_region ${Region}\nsv_contact \u0022${Contact}\u0022\nsv_tags \u0022${Tags}\u0022\nsv_lan 0\n\n// ---- Gameplay ----\nmp_timelimit ${TimeLimit}\nmp_maxrounds ${MaxRounds}\nmp_winlimit ${WinLimit}\nmp_friendlyfire ${FriendlyFire}\nmp_autoteambalance ${AutoBalance}\nmp_teams_unbalance_limit 1\ntf_weapon_criticals ${Crits}\nsv_alltalk ${AllTalk}\nmp_idledealmethod 1\nmp_idlemaxtime 3\nsv_cheats 0\nsv_pausable 0\nmp_tournament 0\nmapcyclefile \u0022mapcycle.txt\u0022\n\n// ---- Files / downloads ----\nsv_allowdownload ${AllowDownload}\nsv_allowupload ${AllowUpload}\nnet_maxfilesize 64\n\n// ---- RCON brute-force protection ----\nsv_rcon_banpenalty 30\nsv_rcon_maxfailures 5\nsv_rcon_minfailures 5\nsv_rcon_minfailuretime 30\n\n// ---- Logging ----\nlog on\nsv_logfile 1\nsv_log_onefile 0\nsv_logbans 1\nsv_logecho 1\n\n// ---- Bans ----\nexec banned_user.cfg\nexec banned_ip.cfg\nwriteid\nwriteip\n\nexec custom.cfg\n",
