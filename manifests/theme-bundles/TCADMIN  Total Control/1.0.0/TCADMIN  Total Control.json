    "logoUrl": "/img/logos/tcadmin-blue.png",
    "customCss": "@import url(\u0027https://fonts.googleapis.com/css2?family=JetBrains\u002BMono:wght@500\u0026family=Saira\u002BCondensed:wght@800\u0026display=swap\u0027);\n/* TCADMIN \u2014 Total Control loader: the www.tcadmin.com splash (cut-corner ring \u002B sweeping arc, glowing mark, spaced wordmark, scan bar). Dark-scheme channel only: the engine strips CustomCss in light mode. */\n@property --tca-ld-a { syntax: \u0027\u003Cangle\u003E\u0027; inherits: false; initial-value: 0deg; }\n#tcadmin-loading .loading-bg-image { display: none; }\n#tcadmin-loading .loading-bg-overlay { opacity: 1 !important; background: radial-gradient(60% 60% at 50% 50%, #08244a 0%, #051327 60%, #030c1d 100%); }\n#tcadmin-loading .loading-bg-overlay::after { content: \u0027\u0027; position: absolute; inset: 0; background-image: linear-gradient(to right, rgb(120 170 230 / 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgb(120 170 230 / 0.05) 1px, transparent 1px); background-size: 64px 64px; background-position: center; -webkit-mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%); mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%); }\n#tcadmin-loading .loading-glass-card { max-width: 280px; padding: 0; gap: 22px; background: transparent; border: 0; border-radius: 0; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }\n#tcadmin-loading .loading-glass-card::before, #tcadmin-loading .loading-glass-card::after { content: \u0027\u0027; position: absolute; left: 50%; pointer-events: none; }\n#tcadmin-loading .loading-glass-card::before { top: 0; width: 132px; height: 132px; margin-left: -66px; z-index: 0; clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px); background: conic-gradient(from var(--tca-ld-a), transparent 0 62%, #01a5df 78%, #7fdcff 82%, transparent 86%), #12345c; animation: tca-ld-spin 1.4s linear infinite; }\n#tcadmin-loading .loading-glass-card::after { top: 2px; width: 128px; height: 128px; margin-left: -64px; z-index: 1; clip-path: polygon(17px 0, 100% 0, 100% calc(100% - 17px), calc(100% - 17px) 100%, 0 100%, 0 17px); background: #061a35; }\n/* logoUrl is the brand-blue mark (what light mode shows, unstyled); dark swaps in the black mark and whitens it. */\n#tcadmin-loading .loading-logo { content: url(\u0027/img/logos/tcadmin.png\u0027); position: relative; z-index: 2; width: 76px; height: 76px; max-height: none; margin: 28px; border-radius: 0; filter: brightness(0) invert(1) drop-shadow(0 0 14px rgba(1, 165, 223, 0.9)); animation: tca-ld-mark 2.4s ease-in-out infinite; }\n#tcadmin-loading .loading-brand-title { font: 800 22px/1 \u0027Saira Condensed\u0027, \u0027Arial Narrow\u0027, sans-serif; letter-spacing: 0.42em; padding-left: 0.42em; text-transform: uppercase; color: #eaf1fa; text-shadow: 0 0 18px rgba(1, 165, 223, 0.55); }\n#tcadmin-loading .loading-progress-wrapper { width: 180px; }\n#tcadmin-loading .loading-progress-track { height: 3px; border-radius: 0; background: #102a4a; }\n#tcadmin-loading .loading-progress-track::after { content: \u0027\u0027; position: absolute; inset: 0; width: 40%; background: linear-gradient(90deg, transparent, rgba(127, 220, 255, 0.55), transparent); animation: tca-ld-scan 1s ease-in-out infinite; }\n#tcadmin-loading .loading-progress-fill { border-radius: 0; background: linear-gradient(90deg, #01a5df, #7fdcff); box-shadow: 0 0 10px rgba(1, 165, 223, 0.6); animation: none; }\n#tcadmin-loading .loading-status { font: 500 11px/1 \u0027JetBrains Mono\u0027, ui-monospace, monospace; letter-spacing: 0.2em; text-transform: uppercase; color: #7189aa; opacity: 1; animation: none; }\n@keyframes tca-ld-spin { to { --tca-ld-a: 360deg; } }\n@keyframes tca-ld-mark { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.06) rotate(18deg); } }\n@keyframes tca-ld-scan { from { transform: translateX(-110%); } to { transform: translateX(260%); } }\n@media (prefers-reduced-motion: reduce) { #tcadmin-loading .loading-glass-card::before, #tcadmin-loading .loading-logo, #tcadmin-loading .loading-progress-track::after { animation: none; } }"
  },
  "paletteMode": "LightAndDark",
