      "id": 394,
      "relativePath": "left4dead2\\cfg\\server.cfg",
      "description": "Server settings (server.cfg)",
      "template": "// Server name\nhostname \u0022${Hostname}\u0022\n\n// RCON password\nrcon_password \u0022${RconPassword}\u0022\n\n// Join password (empty = public)\nsv_password \u0022${PrivatePassword}\u0022\n\n// Accept direct connections, not only lobby matchmaking\nsv_allow_lobby_connect_only 0\nsv_gametypes \u0022coop,realism,survival,versus,scavenge,mutation12\u0022\n\n// Difficulty for campaign modes: Easy, Normal, Hard, Impossible\nz_difficulty \u0022Normal\u0022\n\n// 0 = no voice from other team, 1 = all talk\nsv_alltalk 0\n\n// Server logging\nlog on\nsv_logbans 1\nsv_logecho 0\nsv_logfile 1\n\n// Ban lists\nexec banned_user.cfg\nexec banned_ip.cfg\n",
