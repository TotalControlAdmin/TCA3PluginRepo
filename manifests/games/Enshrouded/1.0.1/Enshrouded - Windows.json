    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows",
          "Linux"
        ],
        "scriptEvents": [
          "AfterServiceCreated",
          "AfterServiceReinstalled",
          "BeforeServiceStarted"
        ],
        "name": "Install Wine dependencies (VC++)",
        "description": "Startup fix",
        "code": "//refAssemblies: TCAdmin.Web.Shared.dll\nusing System;\nusing System.IO;\nusing System.Diagnostics;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY\n\n// Wine dependency provisioning. The script must be marked Windows (the game's OS) so the script\n// DB-filter (which keys on the GAME OS) fetches it at all; we then gate on the HOST being Linux so\n// winetricks only runs on the Wine path and is a no-op on native Windows hosts.\n// Bound to AfterServiceCreated / AfterServiceReinstalled (runs inside the create/reinstall task, no\n// start timeout) AND BeforeServiceStarted (safety net). Idempotent via a marker. Installs the VC++ /\n// D3D runtimes the game needs into the wine prefix via winetricks, run as the prefix's owning user.\n// winetricks creates the prefix (wineboot) if it doesn't exist yet (create-time); EnsurePrefixAsync\n// at first start then reuses it. The marker is stamped by the shell after winetricks so it survives a\n// cancelled/slow start.\n\nif (!System.OperatingSystem.IsLinux())\n{\n    ScriptConsole.WriteLine(\"[wine-deps] Native Windows host â€” runtimes installed by the OS installer; skipping winetricks.\");\n    return;\n}\n\nstring root = ThisService.RootDirectory;\nstring prefix = Path.Combine(root, \".wine\");\nstring marker = Path.Combine(prefix, \".tcadmin-winedeps\");\n\nif (File.Exists(marker))\n{\n    ScriptConsole.WriteLine(\"[wine-deps] Runtimes already installed in the wine prefix.\");\n    return;\n}\n\nScriptConsole.WriteLine(\"[wine-deps] Installing VC++/D3D runtimes into the wine prefix via winetricks (can take a few minutes)...\");\n\n// Owner is taken from the service ROOT (always present and chowned to the service user by the create's\n// file-permission pass) â€” the .wine prefix may not exist yet at create-time. winetricks creates it.\nstring b = string.Join(\" \",\n    \"set -e;\",\n    $\"ROOT='{root}';\",\n    \"PREFIX=\\\"$ROOT/.wine\\\";\",\n    \"MARKER=\\\"$PREFIX/.tcadmin-winedeps\\\";\",\n    \"OWNER=$(stat -c '%U' \\\"$ROOT\\\");\",\n    \"echo \\\"[wine-deps] service user: $OWNER\\\";\",\n    \"RT=\\\"$ROOT/.tca/xdg-runtime\\\"; mkdir -p \\\"$RT\\\"; chmod 700 \\\"$RT\\\"; chown \\\"$OWNER\\\" \\\"$RT\\\";\",\n    \"runuser -u \\\"$OWNER\\\" -- env WINEPREFIX=\\\"$PREFIX\\\" HOME=\\\"$ROOT\\\" XDG_RUNTIME_DIR=\\\"$RT\\\" WINEDEBUG=-all WINEDLLOVERRIDES='mscoree=;mshtml=' xvfb-run -a winetricks -q vcrun2019 d3dcompiler_47;\",\n    \"touch \\\"$MARKER\\\"; chown \\\"$OWNER\\\" \\\"$MARKER\\\";\",\n    \"echo '[wine-deps] winetricks finished';\");\n\nvar psi = new ProcessStartInfo\n{\n    FileName = \"/bin/bash\",\n    UseShellExecute = false,\n    RedirectStandardOutput = true,\n    RedirectStandardError = true,\n};\npsi.ArgumentList.Add(\"-c\");\npsi.ArgumentList.Add(b);\n\nusing (var p = Process.Start(psi))\n{\n    string outText = await p.StandardOutput.ReadToEndAsync();\n    string errText = await p.StandardError.ReadToEndAsync();\n    await p.WaitForExitAsync();\n    if (!string.IsNullOrWhiteSpace(outText))\n        ScriptConsole.WriteLine(outText.Length > 2500 ? outText.Substring(outText.Length - 2500) : outText);\n    if (!string.IsNullOrWhiteSpace(errText))\n        ScriptConsole.WriteLine(\"[wine-deps stderr] \" + (errText.Length > 1200 ? errText.Substring(errText.Length - 1200) : errText));\n    ScriptConsole.WriteLine($\"[wine-deps] winetricks exit code: {p.ExitCode}\");\n}\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
