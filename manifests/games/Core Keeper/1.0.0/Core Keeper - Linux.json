      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Start the virtual display",
        "description": "Starts the Xvfb display the server needs (installs xvfb and libxi6 when the host does not have them).",
        "code": "//refAssemblies: TCAdmin.Monitor.SDK.dll, System.Diagnostics.Process.dll\nusing System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// The server needs an X display even in -batchmode (it hangs at \u0022Video subsystem has not been initialized\u0022).\n// Each service gets its own virtual display, :\u003Cservice id\u003E, matching the DISPLAY environment variable.\nvar display = \u0022:\u0022 \u002B ThisService.ServiceId;\nbool Shell(string command, out string output)\n{\n    using (var process = Process.Start(new ProcessStartInfo(\u0022/bin/sh\u0022, new[] { \u0022-c\u0022, command }) { RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false }))\n    {\n        output = process.StandardOutput.ReadToEnd() \u002B process.StandardError.ReadToEnd();\n        process.WaitForExit();\n        return process.ExitCode == 0;\n    }\n}\n\nif (!Shell(\u0022command -v Xvfb\u0022, out _))\n{\n    ScriptConsole.WriteLine((object)\u0022Xvfb is missing on this host; installing it.\u0022);\n    var installed = Shell(\u0022command -v apt-get\u0022, out _)\n        ? Shell(\u0022DEBIAN_FRONTEND=noninteractive apt-get install -y xvfb libxi6 || (apt-get update \u0026\u0026 DEBIAN_FRONTEND=noninteractive apt-get install -y xvfb libxi6)\u0022, out var log)\n        : Shell(\u0022(command -v dnf \u0026\u0026 dnf install -y xorg-x11-server-Xvfb libXi) || yum install -y xorg-x11-server-Xvfb libXi\u0022, out log);\n    if (!installed) throw new Exception(\u0022Xvfb could not be installed. Install xvfb libxi6 (Debian/Ubuntu) or xorg-x11-server-Xvfb libXi (Red Hat) on this host. \u0022 \u002B log);\n    ScriptConsole.WriteLine((object)\u0022Installed Xvfb.\u0022);\n}\n\nif (Shell(\u0022pgrep -f \u0027^Xvfb \u0022 \u002B display \u002B \u0022 \u0027\u0022, out _)) return;\nShell(\u0022rm -f /tmp/.X\u0022 \u002B ThisService.ServiceId \u002B \u0022-lock /tmp/.X11-unix/X\u0022 \u002B ThisService.ServiceId, out _);\nvar user = ServiceManagerService.GetServiceCredential(ThisService.ServiceId).UserName;\nShell(\u0022setsid runuser -u \u0027\u0022 \u002B user \u002B \u0022\u0027 -- Xvfb \u0022 \u002B display \u002B \u0022 -screen 0 1x1x24 -nolisten tcp \u003E /dev/null 2\u003E\u00261 \u003C /dev/null \u0026\u0022, out _);\nfor (var i = 0; i \u003C 50 \u0026\u0026 !File.Exists(\u0022/tmp/.X11-unix/X\u0022 \u002B ThisService.ServiceId); i\u002B\u002B) await Task.Delay(100);\nScriptConsole.WriteLine((object)(\u0022Started the virtual display \u0022 \u002B display \u002B \u0022.\u0022));\n",
        "runImpersonated": false,
