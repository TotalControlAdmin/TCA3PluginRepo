  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows",
          "Linux"
        ],
        "scriptEvents": [
          "CustomQueryProtocol"
        ],
        "name": "Squad player query (RCON ShowServerInfo)",
        "description": "Squad dropped A2S after its EOS migration; query via RCON ShowServerInfo instead.",
        "code": "//refAssemblies: TCAdmin.SDK.dll, TCAdmin.GameHosting.SDK.dll, TCAdmin.Scripting.dll, TCAdmin.Monitor.dll, TCAdmin.Web.Shared.dll, System.Text.Json.dll\nusing System;\nusing System.IO;\nusing System.Linq;\nusing System.Text.Json;\nusing TCAdmin.GameHosting.SDK.RconProviders;\nusing TCAdmin.SDK.Hubs.Models.GameQuery;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// CustomQueryProtocol for Squad. Squad dropped Steam A2S after its EOS migration, so query the\n// server's own RCON (ShowServerInfo) for live player count / name / map. The RCON password + port\n// come from SquadGame/ServerConfig/Rcon.cfg (Password + Port set to the allocated RCON port).\nstring address = Variables.Parse<string>(\"Address\", ThisService.IPAddress);\nint rconPort = ThisService.RconPort;\nstring password = \"\";\n\nstring rconCfg = Path.Combine(ThisService.RootDirectory, \"SquadGame\", \"ServerConfig\", \"Rcon.cfg\");\nif (File.Exists(rconCfg))\n{\n    foreach (string raw in File.ReadAllLines(rconCfg))\n    {\n        string line = raw.Trim();\n        if (line.StartsWith(\"//\")) continue;\n        if (line.StartsWith(\"Password=\", StringComparison.OrdinalIgnoreCase))\n            password = line.Substring(\"Password=\".Length).Trim();\n        else if (line.StartsWith(\"Port=\", StringComparison.OrdinalIgnoreCase)\n                 && int.TryParse(line.Substring(\"Port=\".Length).Trim(), out int p))\n            rconPort = p;\n    }\n}\n\nif (string.IsNullOrEmpty(password))\n{\n    ScriptConsole.WriteLine(\"Squad query: RCON password is not set in Rcon.cfg - cannot query.\");\n    return; // no ReturnValue -> query monitoring reports offline\n}\n\nvar factory = RconClientFactories.FirstOrDefault(f => f.Protocol == \"source\");\nif (factory == null)\n{\n    ScriptConsole.WriteLine(\"Squad query: no 'source' RCON factory registered (monitor-only).\");\n    return;\n}\n\nstring info;\nawait using (var rcon = factory.Create())\n{\n    await rcon.ConnectAsync(address, rconPort, password, ThisCancellationToken);\n    info = await rcon.ExecuteCommandAsync(\"ShowServerInfo\", ThisCancellationToken);\n}\n\nif (string.IsNullOrWhiteSpace(info))\n{\n    ScriptConsole.WriteLine(\"Squad query: empty ShowServerInfo response.\");\n    return;\n}\n\nusing (var doc = JsonDocument.Parse(info))\n{\n    var root = doc.RootElement;\n\n    string GetStr(string key, string dflt)\n    {\n        if (root.TryGetProperty(key, out var el))\n            return el.ValueKind == JsonValueKind.String ? (el.GetString() ?? dflt) : el.ToString();\n        return dflt;\n    }\n    int GetInt(string key, int dflt)\n    {\n        if (root.TryGetProperty(key, out var el))\n        {\n            if (el.ValueKind == JsonValueKind.Number && el.TryGetInt32(out int n)) return n;\n            if (el.ValueKind == JsonValueKind.String && int.TryParse(el.GetString(), out int s)) return s;\n        }\n        return dflt;\n    }\n\n    Globals.ReturnValue = new GameQueryResponse\n    {\n        Status = \"online\",\n        Hostname = $\"{address}:{ThisService.GamePort}\",\n        Name = GetStr(\"ServerName_s\", ThisService.Name),\n        GameType = GetStr(\"GameMode_s\", \"\"),\n        Map = GetStr(\"MapName_s\", \"\"),\n        NumPlayers = GetInt(\"PlayerCount_I\", 0),\n        MaxPlayers = GetInt(\"MaxPlayers\", ThisService.Slots)\n    };\n}",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "identifier": "062e4bfe-2703-490f-ab92-d5e64ffeed06"
      }
    }
