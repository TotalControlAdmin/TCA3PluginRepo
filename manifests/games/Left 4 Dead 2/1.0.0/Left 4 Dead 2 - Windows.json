  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Prepare the server",
        "description": "Writes steam_appid.txt so the first start connects to Steam (otherwise LAN only) and keeps the previous console log as console.previous.log.",
        "code": "using System;\nusing System.IO;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\nvar root = (string)ThisService.RootDirectory;\n\n// srcds writes steam_appid.txt next to itself, but only during its first run, which therefore starts without Steam\n// (\"Unable to load Steam support library ... LAN mode only\"). Writing it before every start makes the first one work.\nvar appIdFile = Path.Combine(root, \"steam_appid.txt\");\nif (!File.Exists(appIdFile) || File.ReadAllText(appIdFile).Trim('\\0', '\\r', '\\n', ' ') != \"550\")\n{\n    File.WriteAllText(appIdFile, \"550\\n\");\n    ScriptConsole.WriteLine((object)\"Wrote steam_appid.txt (550).\");\n}\n\n// -condebug appends to console.log forever; keep only the previous run next to the new one.\nvar log = Path.Combine(root, \"left4dead2\", \"console.log\");\nif (File.Exists(log))\n{\n    File.Move(log, Path.Combine(Path.GetDirectoryName(log), \"console.previous.log\"), true);\n}\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "f301eb34-d89b-4e02-8d16-78902a7e9a90"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "AfterCustomModInstalled"
        ],
        "name": "Install the Workshop add-on",
        "description": "Moves the downloaded .vpk into left4dead2/addons/workshop",
        "code": "using System;\nusing System.IO;\nusing System.Linq;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Left 4 Dead 2 loads add-ons (.vpk) from left4dead2/addons and left4dead2/addons/workshop. The Workshop\n// download lands in steamapps/Workshop/content/550/<id>/...; move every .vpk it contains into\n// left4dead2/addons/workshop as <id>.vpk (the name the game itself uses), so the server loads it on the\n// next map change or restart. Files created here are tracked and removed again when the mod is uninstalled.\nstring fileId = Convert.ToString(Dynamic.FileId).Trim();\nstring installPath = Convert.ToString(Dynamic.InstallPath);\nstring root = (string)ThisService.RootDirectory;\nstring addons = Path.Combine(root, \"left4dead2\", \"addons\", \"workshop\");\nDirectory.CreateDirectory(addons);\n\nif (!Directory.Exists(installPath))\n{\n    ScriptConsole.WriteLine((object)(\"Nothing was downloaded for Workshop item \" + fileId + \".\"));\n    return;\n}\n\nvar vpks = Directory.GetFiles(installPath, \"*.vpk\", SearchOption.AllDirectories).OrderBy(x => x, StringComparer.Ordinal).ToArray();\nif (vpks.Length == 0)\n{\n    ScriptConsole.WriteLine((object)(\"Workshop item \" + fileId + \" contains no .vpk add-on; nothing to install.\"));\n    return;\n}\n\nfor (var i = 0; i < vpks.Length; i++)\n{\n    string name = i == 0 ? fileId + \".vpk\" : fileId + \"_\" + i + \".vpk\";\n    string target = Path.Combine(addons, name);\n    File.Move(vpks[i], target, true);\n    ScriptConsole.WriteLine((object)(\"Installed \" + Path.GetFileName(vpks[i]) + \" as left4dead2/addons/workshop/\" + name));\n}\n\n// The download folder is empty now; remove it so only the add-on is left.\ntry { Directory.Delete(installPath, true); } catch { }\nScriptConsole.WriteLine((object)\"The add-on is loaded the next time the server starts or changes map.\");\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "5dc7843b-66d6-44ca-8d65-1be7b41b096f"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeCustomModUninstalled"
        ],
        "name": "Remove the Workshop add-on",
        "description": "Deletes the add-on from left4dead2/addons/workshop",
        "code": "using System;\nusing System.IO;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Removes the add-on files the install script placed in left4dead2/addons/workshop (<id>.vpk, <id>_<n>.vpk).\n// The server keeps an open handle on a loaded .vpk on Windows, so a running server must be stopped first.\nstring fileId = Convert.ToString(Dynamic.FileId).Trim();\nstring root = (string)ThisService.RootDirectory;\nstring addons = Path.Combine(root, \"left4dead2\", \"addons\", \"workshop\");\nif (!Directory.Exists(addons)) return;\n\nforeach (var file in Directory.GetFiles(addons, fileId + \"*.vpk\"))\n{\n    string name = Path.GetFileNameWithoutExtension(file);\n    if (name != fileId && !name.StartsWith(fileId + \"_\", StringComparison.Ordinal)) continue;\n    try { File.Delete(file); ScriptConsole.WriteLine((object)(\"Removed left4dead2/addons/workshop/\" + Path.GetFileName(file))); }\n    catch (Exception ex) { ScriptConsole.WriteLine((object)(\"Could not remove \" + Path.GetFileName(file) + \" (\" + ex.Message + \"). Stop the server and uninstall again.\")); throw; }\n}\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
