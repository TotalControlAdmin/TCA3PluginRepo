      "id": 377,
      "relativePath": "hl2mp\\cfg\\server.cfg",
      "description": "Server settings (server.cfg)",
      "template": "// Server name\nhostname \u0022${Hostname}\u0022\n\n// RCON password\nrcon_password \u0022${RconPassword}\u0022\n\n// Join password (empty = public)\nsv_password \u0022${PrivatePassword}\u0022\n\n// 0 = deathmatch (free for all), 1 = team deathmatch (Combine vs Rebels)\nmp_teamplay ${Teamplay}\n\n// Minutes per map (0 = no limit) and frags to win a map (0 = no limit)\nmp_timelimit ${TimeLimit}\nmp_fraglimit ${FragLimit}\n\n// Gameplay\nmp_friendlyfire 0\nmp_forcerespawn 1\nmp_weaponstay 0\nmp_flashlight 1\nmp_footsteps 1\nsv_alltalk 0\n\n// Server logging\nlog on\nsv_logbans 1\nsv_logecho 0\nsv_logfile 1\n\n// Ban lists\nexec banned_user.cfg\nexec banned_ip.cfg\n",
