  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "DownloadGameFiles"
        ],
        "name": "Download Windows game files",
        "code": "using System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Net.Http;\nusing TCAdmin.SDK.Misc;\nusing TCAdmin.SDK.Misc.Extensions;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\nvar gameFilesPath = Globals.ThisServer.Configuration.GameFilesPath;\nvar downloadedFile = Path.Combine(gameFilesPath, \"WolfET.exe\");\nvar patchFile = Path.Combine(gameFilesPath, \"__ET_Patch_2_60.exe\");\n\nif (!Directory.Exists(gameFilesPath)) \n    Directory.CreateDirectory(gameFilesPath);\n\nusing (HttpClient downloadClient = new HttpClient())\n{\n    // Download and run WolfET.exe\n    await downloadClient.DownloadFile(\"http://downloads.tcadmin.com/games/wolfet-windows.aspx\", downloadedFile, Globals.ThisCancellationToken);\n    \n    var process = new Process();\n    process.StartInfo.FileName = downloadedFile;\n    process.StartInfo.Arguments = \"/s\";\n    process.Start();\n    await process.WaitForExitAsync(Globals.ThisCancellationToken);\n    \n    // Download and run ET_Patch_2_60.exe\n    await downloadClient.DownloadFile(\"http://downloads.tcadmin.net/games/wolfet-update-windows.aspx\", patchFile, Globals.ThisCancellationToken);\n}\n\nvar patchProcess = new Process();\npatchProcess.StartInfo.FileName = patchFile;\npatchProcess.StartInfo.Arguments = \"/s\";\npatchProcess.Start();\nawait patchProcess.WaitForExitAsync(Globals.ThisCancellationToken);\n\n// Clean up downloaded files\nFile.Delete(downloadedFile);\nFile.Delete(patchFile);\n\n// Determine install folder based on architecture\nstring installFolder;\nif (Environment.Is64BitOperatingSystem)\n{\n    installFolder = Path.Combine(Environment.GetEnvironmentVariable(\"ProgramFiles(x86)\"), \"Wolfenstein - Enemy Territory\");\n}\nelse\n{\n    installFolder = Path.Combine(Environment.GetEnvironmentVariable(\"ProgramFiles\"), \"Wolfenstein - Enemy Territory\");\n}\n\n// Copy game files to service folder\nvar filesFolderFullName = Path.Combine(gameFilesPath, Globals.ThisGame.FileAndDirectoryConfig.AutoSetupFolderName);\nFileSystem.CopyDirectory(installFolder, filesFolderFullName);",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
