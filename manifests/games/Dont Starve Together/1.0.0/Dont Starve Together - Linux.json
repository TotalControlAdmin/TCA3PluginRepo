  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Prepare the server",
        "description": "Warns when no cluster token is set and installs the libraries the server needs when the host does not have them.",
        "code": "//refAssemblies: System.Diagnostics.Process.dll\nusing System;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\nvar root = (string)ThisService.RootDirectory;\nvar cluster = Path.Combine(root, \u0022DoNotStarveTogether\u0022, \u0022Cluster_1\u0022);\n\n// Without a cluster token an online server stops at \u0022E_INVALID_TOKEN ... Your Server Will Not Start\u0022 but its process\n// stays alive, so refuse the start with the reason instead. An offline (LAN) cluster needs no token.\nvar tokenFile = Path.Combine(cluster, \u0022cluster_token.txt\u0022);\nvar clusterIni = Path.Combine(cluster, \u0022cluster.ini\u0022);\nvar offline = File.Exists(clusterIni) \u0026\u0026 File.ReadAllLines(clusterIni).Any(l =\u003E l.Replace(\u0022 \u0022, \u0022\u0022).Equals(\u0022offline_cluster=true\u0022, StringComparison.OrdinalIgnoreCase));\nif (!offline \u0026\u0026 (!File.Exists(tokenFile) || File.ReadAllText(tokenFile).Trim().Length == 0))\n{\n    throw new Exception(\u0022The server needs a Klei cluster token. In the game choose Play \u003E Account \u003E Game Servers \u003E Add New Server, copy the token and paste it in Configuration Files \u003E Cluster token.\u0022);\n}\n\n// Linux: install the shared libraries the server binary links but this host does not have.\nif (System.OperatingSystem.IsLinux())\n{\n    var binary = Path.Combine(root, \u0022bin64\u0022, \u0022dontstarve_dedicated_server_nullrenderer_x64\u0022);\n    var packages = new Dictionary\u003Cstring, (string[] Apt, string[] Rpm)\u003E\n    {\n        [\u0022libcurl-gnutls.so.4\u0022] = (new[] { \u0022libcurl3-gnutls\u0022, \u0022libcurl3t64-gnutls\u0022 }, new[] { \u0022libcurl\u0022 })\n    };\n    Shell(\u0022ldd \u0027\u0022 \u002B binary \u002B \u0022\u0027\u0022, out var lddOutput);\n    var missing = lddOutput.Split(\u0027\\n\u0027).Where(l =\u003E l.Contains(\u0022=\u003E not found\u0022)).Select(l =\u003E l.Trim().Split(\u0027 \u0027)[0]).ToList();\n    foreach (var soname in missing)\n    {\n        if (!packages.TryGetValue(soname, out var candidates))\n        {\n            ScriptConsole.WriteLine((object)(\u0022The server needs \u0022 \u002B soname \u002B \u0022, which is not installed on this host.\u0022));\n            continue;\n        }\n        ScriptConsole.WriteLine((object)(soname \u002B \u0022 is missing on this host; installing it.\u0022));\n        var apt = Shell(\u0022command -v apt-get\u0022, out _);\n        var tool = apt ? \u0022DEBIAN_FRONTEND=noninteractive apt-get install -y \u0022 : Shell(\u0022command -v dnf\u0022, out _) ? \u0022dnf install -y \u0022 : \u0022yum install -y \u0022;\n        var names = apt ? candidates.Apt : candidates.Rpm;\n        var installed = names.Any(p =\u003E Shell(tool \u002B p, out _));\n        if (!installed \u0026\u0026 apt \u0026\u0026 Shell(\u0022apt-get update\u0022, out _)) installed = names.Any(p =\u003E Shell(tool \u002B p, out _));\n        if (!installed) throw new Exception(soname \u002B \u0022 is missing and could not be installed. Install one of these packages on the host: \u0022 \u002B string.Join(\u0022, \u0022, names));\n        ScriptConsole.WriteLine((object)(\u0022Installed \u0022 \u002B soname \u002B \u0022.\u0022));\n    }\n}\n\nbool Shell(string command, out string output)\n{\n    using (var process = Process.Start(new ProcessStartInfo(\u0022/bin/sh\u0022, new[] { \u0022-c\u0022, command }) { RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false }))\n    {\n        output = process.StandardOutput.ReadToEnd() \u002B process.StandardError.ReadToEnd();\n        process.WaitForExit();\n        return process.ExitCode == 0;\n    }\n}\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
