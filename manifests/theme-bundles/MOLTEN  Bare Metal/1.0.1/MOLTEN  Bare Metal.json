    "textColor": "#edeef2",
    "backgroundColor": "#0b0d11",
    "backgroundImageUrl": "",
    "backgroundOverlayOpacity": 0.7,
    "glassCardBackground": "rgba(17,20,26,0.82)",
    "progressBarColor": "#ff7a2e",
    "customCss": "/* MOLTEN pre-Blazor boot loader (theme.loadingScreen.customCss, NOT the layout template).\n   Single-sourced here; build.ps1 / build-local.ps1 read it, push-loader-local.ps1 updates it live.\n   Dark scheme only \u2014 App.razor drops CustomCss in light mode, so light keeps the app.css default. */\n@import url(\u0027https://fonts.googleapis.com/css2?family=Oxanium:wght@700;800\u0026display=swap\u0027);\n#tcadmin-loading .loading-bg-image{background:radial-gradient(1000px 600px at 10% 112%,rgba(255,102,26,.28),transparent 62%),radial-gradient(700px 400px at 90% -10%,rgba(90,169,230,.08),transparent 55%),linear-gradient(160deg,#101318 0%,#0b0d11 55%,#0d0a08 100%)!important;background-color:#0b0d11!important}\n#tcadmin-loading .loading-glass-card{border:1px solid rgba(255,122,46,.28);border-radius:16px;box-shadow:0 0 40px rgba(255,90,20,.18),inset 0 1px 0 rgba(255,255,255,.07);position:relative;overflow:hidden}\n#tcadmin-loading .loading-glass-card::after{content:\u0022\u0022;position:absolute;left:8%;right:8%;bottom:0;height:2px;background:linear-gradient(90deg,transparent,#ff9d2e 20%,#ffd9a1 50%,#ff7a2e 80%,transparent);background-size:220% 100%;box-shadow:0 0 16px rgba(255,122,46,.7)}\n#tcadmin-loading .loading-brand-title{font-family:\u0027Oxanium\u0027,sans-serif;letter-spacing:.24em;text-transform:uppercase;font-weight:700}\n\n/* ---- warming up ----\n   The forge lights while the app boots: everything starts ash-cold and comes up to temperature.\n   Same story the running panel tells with --tca-cool, just on a timer \u2014 the loader has no service\n   state to read. \u0060both\u0060 holds the hot end when boot outlasts the ramp; the seam keeps its flow\n   loop and gains a fade-in as a second animation. */\n#tcadmin-loading .loading-bg-image{animation:mlt-warm-bg 4.2s ease-out both}\n#tcadmin-loading .loading-glass-card{animation:mlt-warm-card 4.2s ease-out both}\n#tcadmin-loading .loading-brand-title{animation:mlt-warm-title 4.2s ease-out both}\n#tcadmin-loading .loading-glass-card::after{animation:mlt-loading-flow 7s linear infinite,mlt-warm-seam 4.2s ease-out both}\n#tcadmin-loading .loading-progress-fill{animation:mlt-warm-fill 4.2s ease-out both}\n#tcadmin-loading .loading-status{animation:mlt-warm-status 4.2s ease-out both}\n\n@keyframes mlt-loading-flow{0%{background-position:0% 0}100%{background-position:220% 0}}\n@keyframes mlt-warm-bg{\n  0%{filter:saturate(.1) brightness(.6)}\n  45%{filter:saturate(.55) brightness(.85)}\n  100%{filter:saturate(1) brightness(1)}}\n@keyframes mlt-warm-card{\n  0%{border-color:rgba(120,132,148,.2);box-shadow:0 0 0 rgba(255,90,20,0),inset 0 1px 0 rgba(255,255,255,.03)}\n  100%{border-color:rgba(255,122,46,.28);box-shadow:0 0 40px rgba(255,90,20,.18),inset 0 1px 0 rgba(255,255,255,.07)}}\n/* Ash -\u003E ember -\u003E settled: the overshoot at 60% is what sells \u0022it just caught\u0022. */\n@keyframes mlt-warm-title{\n  0%{color:#5b6472;text-shadow:none}\n  60%{color:#ff7a2e;text-shadow:0 0 28px rgba(255,122,46,.6)}\n  100%{color:var(--text-color,#edeef2);text-shadow:0 0 18px rgba(255,122,46,.38)}}\n@keyframes mlt-warm-seam{0%{opacity:0;filter:saturate(.1)}30%{opacity:.28}100%{opacity:1;filter:saturate(1)}}\n@keyframes mlt-warm-fill{\n  0%{filter:saturate(.12) brightness(.65);box-shadow:none}\n  100%{filter:saturate(1) brightness(1);box-shadow:0 0 14px rgba(255,122,46,.55)}}\n@keyframes mlt-warm-status{0%{opacity:.35}100%{opacity:1}}\n\n/* Reduced motion: no ramp, no flow \u2014 \u0060both\u0060 means the elements simply render their hot end. */\n@media (prefers-reduced-motion:reduce){\n  #tcadmin-loading .loading-bg-image,#tcadmin-loading .loading-glass-card,\n  #tcadmin-loading .loading-brand-title,#tcadmin-loading .loading-glass-card::after,\n  #tcadmin-loading .loading-progress-fill,#tcadmin-loading .loading-status{animation:none}\n}\n"
  },
  "createdDate": "0001-01-01T00:00:00"
}