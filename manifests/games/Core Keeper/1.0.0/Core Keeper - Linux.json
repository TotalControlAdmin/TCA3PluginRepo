  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStopped"
        ],
        "name": "Graceful stop",
        "description": "Asks the server to save and exit (SIGTERM) and waits for it.",
        "code": "//refAssemblies: System.Diagnostics.Process.dll\nusing System;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Graceful stop: the server saves and exits on a close request (taskkill without /f on Windows, SIGTERM on Linux),\n// which the panel's own stop does not send. Only the server binary of THIS service is signalled.\nvar root = Path.GetFullPath((string)ThisService.RootDirectory).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;\nvar binary = \"CoreKeeperServer\";\nconst int maxWaitSeconds = 120;\n\nList<int> ServerPids()\n{\n    var pids = new List<int>();\n    if (System.OperatingSystem.IsWindows())\n    {\n        foreach (var p in Process.GetProcessesByName(Path.GetFileNameWithoutExtension(binary)))\n        {\n            try { if (p.MainModule.FileName.StartsWith(root, StringComparison.OrdinalIgnoreCase)) pids.Add(p.Id); }\n            catch { } // exited meanwhile\n        }\n        return pids;\n    }\n    foreach (var dir in Directory.EnumerateDirectories(\"/proc\"))\n    {\n        if (!int.TryParse(Path.GetFileName(dir), out var pid)) continue;\n        try\n        {\n            var exe = new FileInfo(Path.Combine(dir, \"exe\")).LinkTarget ?? \"\";\n            if (exe.StartsWith(root, StringComparison.Ordinal) && Path.GetFileName(exe) == binary) pids.Add(pid);\n        }\n        catch { } // processes of other users, or gone meanwhile\n    }\n    return pids;\n}\n\nvar targets = ServerPids();\nif (targets.Count == 0)\n{\n    ScriptConsole.WriteLine((object)\"The server is not running.\");\n    return;\n}\nforeach (var pid in targets)\n{\n    var signal = System.OperatingSystem.IsWindows()\n        ? new ProcessStartInfo(\"taskkill.exe\", new[] { \"/pid\", pid.ToString() })\n        : new ProcessStartInfo(\"kill\", new[] { \"-TERM\", pid.ToString() });\n    signal.UseShellExecute = false; signal.RedirectStandardOutput = true; signal.RedirectStandardError = true;\n    using (var process = Process.Start(signal)) process.WaitForExit();\n}\nScriptConsole.WriteLine((object)(\"Asked the server (\" + string.Join(\", \", targets) + \") to save and exit.\"));\nfor (var second = 1; second <= maxWaitSeconds; second++)\n{\n    await Task.Delay(1000, ThisCancellationToken);\n    if (ServerPids().Count == 0)\n    {\n        ScriptConsole.WriteLine((object)(\"The server exited after \" + second + \" s.\"));\n        return;\n    }\n}\nScriptConsole.WriteLine((object)(\"The server did not exit within \" + maxWaitSeconds + \" s; the panel stops it now.\"));\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "ce56c1f4-5077-4830-bb39-95226790da24"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Start the virtual display",
        "description": "Starts the Xvfb display the server needs (installs xvfb and libxi6 when the host does not have them).",
        "code": "//refAssemblies: TCAdmin.Monitor.SDK.dll, System.Diagnostics.Process.dll\nusing System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// The server needs an X display even in -batchmode (it hangs at \"Video subsystem has not been initialized\").\n// Each service gets its own virtual display, :<service id>, matching the DISPLAY environment variable.\nvar display = \":\" + ThisService.ServiceId;\nbool Shell(string command, out string output)\n{\n    using (var process = Process.Start(new ProcessStartInfo(\"/bin/sh\", new[] { \"-c\", command }) { RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false }))\n    {\n        output = process.StandardOutput.ReadToEnd() + process.StandardError.ReadToEnd();\n        process.WaitForExit();\n        return process.ExitCode == 0;\n    }\n}\n\nif (!Shell(\"command -v Xvfb\", out _))\n{\n    ScriptConsole.WriteLine((object)\"Xvfb is missing on this host; installing it.\");\n    var installed = Shell(\"command -v apt-get\", out _)\n        ? Shell(\"DEBIAN_FRONTEND=noninteractive apt-get install -y xvfb libxi6 || (apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y xvfb libxi6)\", out var log)\n        : Shell(\"(command -v dnf && dnf install -y xorg-x11-server-Xvfb libXi) || yum install -y xorg-x11-server-Xvfb libXi\", out log);\n    if (!installed) throw new Exception(\"Xvfb could not be installed. Install xvfb libxi6 (Debian/Ubuntu) or xorg-x11-server-Xvfb libXi (Red Hat) on this host. \" + log);\n    ScriptConsole.WriteLine((object)\"Installed Xvfb.\");\n}\n\nif (Shell(\"pgrep -f '^Xvfb \" + display + \" '\", out _)) return;\nShell(\"rm -f /tmp/.X\" + ThisService.ServiceId + \"-lock /tmp/.X11-unix/X\" + ThisService.ServiceId, out _);\nvar user = ServiceManagerService.GetServiceCredential(ThisService.ServiceId).UserName;\nShell(\"setsid runuser -u '\" + user + \"' -- Xvfb \" + display + \" -screen 0 1x1x24 -nolisten tcp > /dev/null 2>&1 < /dev/null &\", out _);\nfor (var i = 0; i < 50 && !File.Exists(\"/tmp/.X11-unix/X\" + ThisService.ServiceId); i++) await Task.Delay(100);\nScriptConsole.WriteLine((object)(\"Started the virtual display \" + display + \".\"));\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
