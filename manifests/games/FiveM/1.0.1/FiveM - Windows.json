  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "DownloadGameFiles"
        ],
        "name": "Download Windows game files",
        "code": "//refAssemblies: TCAdmin.SDK.dll, TCAdmin.GameHosting.SDK.dll, TCAdmin.Scripting.dll, TCAdmin.Monitor.dll\nusing System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Net;\nusing System.Net.Http;\nusing TCAdmin.SDK.Helpers;\nusing TCAdmin.SDK.Misc.Extensions;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\nusing(var p = new Process())\n{\n    p.StartInfo.FileName = \u0022git.exe\u0022;\n    try\n    {\n        p.Start();\n    }\n    catch (Exception)\n    {\n        throw new Exception(\u0022Please install git with \\\u0022Use Git from the Windows Command Prompt\\\u0022 checked and restart the monitor.\u0022);\n    }\n};\n\nvoid WriteLog(string s, int? progress = null, bool rewriteLastLog = false)\n{\n    if(Globals.ThisTaskStepHandler != null)\n    {\n        Globals.ThisTaskStepHandler.UpdateProgress(progress: progress, log: s);\n    }\n    else if(Globals.ThisTaskStep!=null)\n    {\n        if(progress.HasValue)\n        {\n            Globals.ThisTaskStep.Progress = progress.Value;\n        }\n\n        if(rewriteLastLog)\n        {\n            Globals.ThisTaskStep.DisplayLog = s;\n            Globals.ThisTaskStep.DisplayDebugLog = s;\n        }\n        else\n        {\n            Globals.ThisTaskStep.AddDebugLog(s, skipDuplicates:true);\n        }\n        Globals.TCATaskManager.Update(Globals.ThisTask, true);\n    }\n    else\n    {\n        Globals.ScriptConsole.WriteLine(s);\n    }\n}\n\nvar gameFilesPath = Globals.ThisServer.Configuration.GameFilesPath;\nvar fiveMPath = Path.Combine(gameFilesPath, Globals.ThisGame.FileAndDirectoryConfig.AutoSetupFolderName);\nvar downloadedFile = Path.Combine(gameFilesPath, \u0022__fivem.7z\u0022);\nvar tools = Path.Combine(InstallLocator.GetInstallRoot(), \u0022data\u0022, \u0022tools\u0022);\nif(!Directory.Exists(tools)) Directory.CreateDirectory(tools);\nvar _7zaUrl = \u0022https://www.7-zip.org/a/7za920.zip\u0022;\nvar _7zaZip = Path.Combine(InstallLocator.GetInstallRoot(), \u0022data\u0022, \u0022tools\u0022, \u00227za.zip\u0022);\nvar _7zaPath = Path.Combine(InstallLocator.GetInstallRoot(), \u0022data\u0022, \u0022tools\u0022, \u00227za\u0022);\nvar _7zaExe = Path.Combine(_7zaPath, \u00227za.exe\u0022);\n\nusing (HttpClient downloadClient = new HttpClient())\n{\n    // Download fivem server files\n    await downloadClient.DownloadFile(\u0022http://downloads.tcadmin.net/games/fivem-windows-7z.aspx\u0022, downloadedFile, Globals.ThisCancellationToken);\n}\n\n// Download 7zip if needed\nif (!File.Exists(_7zaExe))\n{\n    WriteLog(\u0022Downloading 7zip...\u0022);\n    using var wc = new HttpClient();\n    using var response = await wc.GetAsync(_7zaUrl, Globals.ThisCancellationToken);\n    using var fs = File.Create(_7zaZip);\n    await response.Content.CopyToAsync(fs, Globals.ThisCancellationToken);\n    fs.Close();\n    \n    ZipFile.ExtractToDirectory(_7zaZip, _7zaPath);\n    File.Delete(_7zaZip);\n}\n\n// Extract fivem.7z\nusing (var p = new Process())\n{\n    p.StartInfo.FileName = _7zaExe;\n    p.StartInfo.Arguments = $\u0022x -y -o\\\u0022{fiveMPath}\\\u0022 \\\u0022{downloadedFile}\\\u0022\u0022;\n    p.StartInfo.WorkingDirectory = _7zaPath;\n    p.Start();\n    p.WaitForExit();\n}\n\nFile.Delete(downloadedFile);\n\n// Download server-data\nusing (var p = new Process())\n{\n    p.StartInfo.FileName = \u0022git.exe\u0022;\n    p.StartInfo.Arguments = \u0022clone https://github.com/citizenfx/cfx-server-data.git server-data\u0022;\n    p.StartInfo.WorkingDirectory = fiveMPath;\n    p.Start();\n    p.WaitForExit();\n}",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
