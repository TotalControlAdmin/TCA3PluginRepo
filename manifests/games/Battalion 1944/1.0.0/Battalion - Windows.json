        "translations": [],
        "identifier": "b0534444-f440-4903-9c9b-18988e5ec753"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeServiceStopped"
        ],
        "name": "Graceful stop via Ctrl\u002BC (windows-kill)",
        "description": "Global graceful stop: on BeforeServiceStopped sends Ctrl\u002BC (SIGINT) to the game process via windows-kill.exe (auto-downloaded to the hidden .tca folder). Windows-only; skips non-game services.",
        "code": "//refAssemblies: TCAdmin.SDK.dll, TCAdmin.GameHosting.SDK.dll, TCAdmin.Scripting.dll, TCAdmin.Monitor.dll, TCAdmin.Web.Shared.dll, System.Net.Http.dll, System.IO.Compression.dll, System.IO.Compression.ZipFile.dll, System.Diagnostics.Process.dll\nusing System;\nusing System.Diagnostics;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Net.Http;\nusing System.Threading;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Global graceful-stop helper (Windows). On BeforeServiceStopped, send Ctrl\u002BC (SIGINT)\n// to the running game-server process via windows-kill.exe so it shuts down cleanly before\n// TCAdmin performs its own stop. windows-kill.exe is downloaded on demand into the hidden\n// {serviceroot}/.tca folder (so the customer never sees it) and reused on later stops.\n\n// Only game services expose a single tracked process id; skip anything else (Docker/base).\nvar gameService = (object)ThisService as GameService;\nif (gameService == null)\n{\n    ScriptConsole.WriteLine(\u0022Not a game service; skipping graceful Ctrl\u002BC stop.\u0022);\n    return;\n}\n\nint? pid = gameService.ProcessId;\nif (pid == null || pid \u003C= 0)\n{\n    ScriptConsole.WriteLine(\u0022No running process id for this service; nothing to stop.\u0022);\n    return;\n}\n\n// Keep windows-kill.exe in the hidden .tca folder so it isn\u0027t visible to the user.\nstring toolDir = Path.Combine(RootDirectory, \u0022.tca\u0022);\nstring killExe = Path.Combine(toolDir, \u0022windows-kill.exe\u0022);\n\n// Download windows-kill.exe on demand if it isn\u0027t cached yet.\nif (!File.Exists(killExe))\n{\n    const string url = \u0022https://github.com/ElyDotDev/windows-kill/releases/download/1.1.4/windows-kill_1.1.4_release.zip\u0022;\n    const string entryPath = \u0022windows-kill_x64_1.1.4_lib_release/windows-kill.exe\u0022;\n\n    try\n    {\n        Directory.CreateDirectory(toolDir);\n        string zipPath = Path.Combine(toolDir, \u0022windows-kill_1.1.4_release.zip\u0022);\n\n        ScriptConsole.WriteLine($\u0022windows-kill.exe not found; downloading {url}\u0022);\n        using (var http = new HttpClient())\n        {\n            byte[] data = await http.GetByteArrayAsync(url, ThisCancellationToken);\n            await File.WriteAllBytesAsync(zipPath, data, ThisCancellationToken);\n        }\n\n        using (ZipArchive archive = ZipFile.OpenRead(zipPath))\n        {\n            ZipArchiveEntry entry = archive.GetEntry(entryPath);\n            if (entry == null)\n                throw new Exception($\u0022Entry \u0027{entryPath}\u0027 not found in the archive.\u0022);\n            entry.ExtractToFile(killExe, overwrite: true);\n        }\n        ScriptConsole.WriteLine($\u0022Extracted windows-kill.exe to {killExe}\u0022);\n\n        try { File.Delete(zipPath); }\n        catch (Exception ex) { ScriptConsole.WriteLine($\u0022Warning: could not delete zip file: {ex.Message}\u0022); }\n    }\n    catch (Exception ex)\n    {\n        ScriptConsole.WriteLine($\u0022Failed to download windows-kill.exe: {ex.Message}; skipping graceful Ctrl\u002BC stop.\u0022);\n        return;\n    }\n}\n\n// Send Ctrl\u002BC (SIGINT) to the running game process.\nScriptConsole.WriteLine($\u0022Sending SIGINT (Ctrl\u002BC) to process {pid} via windows-kill.exe\u0022);\nvar psi = new ProcessStartInfo\n{\n    FileName = killExe,\n    Arguments = $\u0022-SIGINT {pid}\u0022,\n    WorkingDirectory = RootDirectory,\n    UseShellExecute = false,\n    CreateNoWindow = true,\n    RedirectStandardOutput = true,\n    RedirectStandardError = true\n};\n\ntry\n{\n    using var killer = Process.Start(psi);\n    if (killer != null)\n        await killer.WaitForExitAsync(ThisCancellationToken);\n}\ncatch (Exception ex)\n{\n    ScriptConsole.WriteLine($\u0022Failed to run windows-kill.exe: {ex.Message}\u0022);\n    return;\n}\n\n// Wait up to 60s for the process to exit before TCAdmin proceeds with its own stop.\nconst int maxChecks = 60;\nfor (int count = 1; count \u003C= maxChecks; count\u002B\u002B)\n{\n    bool running;\n    try\n    {\n        using var proc = Process.GetProcessById(pid.Value);\n        running = !proc.HasExited;\n    }\n    catch (ArgumentException)\n    {\n        running = false; // process no longer exists\n    }\n\n    if (!running)\n    {\n        ScriptConsole.WriteLine($\u0022Process {pid} has exited after {count} second(s).\u0022);\n        return;\n    }\n\n    await Task.Delay(TimeSpan.FromSeconds(1), ThisCancellationToken);\n}\n\nScriptConsole.WriteLine($\u0022WARNING: process {pid} did not exit within {maxChecks} seconds.\u0022);\n",
        "runImpersonated": true,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": null,
