  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeServiceStopped"
        ],
        "name": "Save the prospect and shut down",
        "description": "Sends Ctrl\u002BC to the server process, which saves the running prospect and exits.",
        "code": "//refAssemblies: System.Net.Http.dll, System.IO.Compression.dll, System.IO.Compression.ZipFile.dll, System.Diagnostics.Process.dll\nusing System;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Linq;\nusing System.Net.Http;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Graceful stop: the server saves the running prospect and exits on ONE Ctrl\u002BC (a second one quits without saving).\n// Windows: a Ctrl\u002BC sent through its console does not reach it (it ignores console Ctrl\u002BC events), so windows-kill\n// delivers the event straight to the server process. Linux (Wine): a native SIGINT to the server\u0027s Wine process\n// becomes the console Ctrl\u002BC. Only the server process of THIS service is signalled.\nconst string binary = \u0022IcarusServer-Win64-Shipping\u0022;\nconst int maxWaitSeconds = 90;\n\nvar rootPath = Path.GetFullPath((string)ThisService.RootDirectory).TrimEnd(\u0027/\u0027, \u0027\\\\\u0027);\nvar root = rootPath \u002B Path.DirectorySeparatorChar;\nvar rootSlash = rootPath.Replace(\u0027\\\\\u0027, \u0027/\u0027) \u002B \u0022/\u0022;\n\nList\u003Cint\u003E ServerPids()\n{\n    var pids = new List\u003Cint\u003E();\n    if (System.OperatingSystem.IsWindows())\n    {\n        foreach (var p in Process.GetProcessesByName(binary))\n        {\n            try { if (p.MainModule.FileName.StartsWith(root, StringComparison.OrdinalIgnoreCase)) pids.Add(p.Id); }\n            catch { } // exited meanwhile\n        }\n        return pids;\n    }\n    // Wine shows the executable as Z:\\\u003Croot\u003E\\...\\IcarusServer-Win64-Shipping.exe in the command line.\n    foreach (var dir in Directory.EnumerateDirectories(\u0022/proc\u0022))\n    {\n        if (!int.TryParse(Path.GetFileName(dir), out var pid)) continue;\n        try\n        {\n            var args = File.ReadAllText(Path.Combine(dir, \u0022cmdline\u0022)).Replace(\u0027\\0\u0027, \u0027 \u0027).Replace(\u0027\\\\\u0027, \u0027/\u0027);\n            if (args.Contains(binary \u002B \u0022.exe\u0022, StringComparison.OrdinalIgnoreCase) \u0026\u0026 args.Contains(rootSlash, StringComparison.Ordinal)\n                \u0026\u0026 !args.Contains(\u0022start.exe\u0022, StringComparison.OrdinalIgnoreCase))\n                pids.Add(pid);\n        }\n        catch { } // gone meanwhile\n    }\n    pids.Sort();\n    return pids;\n}\n\nvar targets = ServerPids();\nif (targets.Count == 0)\n{\n    ScriptConsole.WriteLine((object)\u0022The server is not running.\u0022);\n    return;\n}\n\nif (System.OperatingSystem.IsWindows())\n{\n    // windows-kill is kept in the hidden .tca folder of the service and downloaded once.\n    var toolDir = Path.Combine(rootPath, \u0022.tca\u0022);\n    var killExe = Path.Combine(toolDir, \u0022windows-kill.exe\u0022);\n    if (!File.Exists(killExe))\n    {\n        const string url = \u0022https://github.com/ElyDotDev/windows-kill/releases/download/1.1.4/windows-kill_1.1.4_release.zip\u0022;\n        const string entryPath = \u0022windows-kill_x64_1.1.4_lib_release/windows-kill.exe\u0022;\n        try\n        {\n            Directory.CreateDirectory(toolDir);\n            using (var http = new HttpClient())\n            using (var zip = new ZipArchive(new MemoryStream(await http.GetByteArrayAsync(url, ThisCancellationToken))))\n            {\n                var entry = zip.GetEntry(entryPath);\n                if (entry == null) throw new Exception(\u0022\u0027\u0022 \u002B entryPath \u002B \u0022\u0027 is not in the archive.\u0022);\n                entry.ExtractToFile(killExe, true);\n            }\n        }\n        catch (Exception ex)\n        {\n            ScriptConsole.WriteLine((object)(\u0022Could not download windows-kill (\u0022 \u002B ex.Message \u002B \u0022); the panel stops the server without saving.\u0022));\n            return;\n        }\n    }\n    foreach (var pid in targets)\n    {\n        // CreateNoWindow gives windows-kill a console of its own, so the event never reaches the monitor.\n        var psi = new ProcessStartInfo(killExe, new[] { \u0022-SIGINT\u0022, pid.ToString() })\n        {\n            UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true,\n            WorkingDirectory = toolDir\n        };\n        using (var killer = Process.Start(psi))\n        {\n            var output = (await killer.StandardOutput.ReadToEndAsync()).Trim();\n            await killer.WaitForExitAsync(ThisCancellationToken);\n            if (killer.ExitCode != 0) ScriptConsole.WriteLine((object)(\u0022windows-kill: \u0022 \u002B output));\n        }\n    }\n}\nelse\n{\n    // One SIGINT to the main server process (the lowest pid); its worker threads share it.\n    targets = targets.Take(1).ToList();\n    using (var kill = Process.Start(new ProcessStartInfo(\u0022kill\u0022, new[] { \u0022-INT\u0022, targets[0].ToString() }) { UseShellExecute = false }))\n        kill.WaitForExit();\n}\n\nScriptConsole.WriteLine((object)(\u0022Asked the server (\u0022 \u002B string.Join(\u0022, \u0022, targets) \u002B \u0022) to save and exit.\u0022));\nfor (var second = 1; second \u003C= maxWaitSeconds; second\u002B\u002B)\n{\n    await Task.Delay(1000, ThisCancellationToken);\n    if (!ServerPids().Any(targets.Contains))\n    {\n        ScriptConsole.WriteLine((object)(\u0022The server exited after \u0022 \u002B second \u002B \u0022 s.\u0022));\n        return;\n    }\n}\nScriptConsole.WriteLine((object)(\u0022The server did not exit within \u0022 \u002B maxWaitSeconds \u002B \u0022 s; the panel stops it now.\u0022));\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "52224677-615f-5841-b06f-02645ad4338c"
      }
    }
