        "scriptRoles": [],
        "editor": [],
        "translations": [],
        "identifier": "65442090-4ba2-489a-b9d8-9440ec9e4435"
      }
    },
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "AfterServiceStopped"
        ],
        "name": "Stop the virtual display",
        "description": "Stops the Xvfb display after the server stopped.",
        "code": "//refAssemblies: System.Diagnostics.Process.dll\nusing System.Diagnostics;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// The service's virtual display is not needed while the server is stopped.\nusing (var kill = Process.Start(new ProcessStartInfo(\"pkill\", new[] { \"-f\", \"^Xvfb :\" + ThisService.ServiceId + \" \" }) { UseShellExecute = false }))\n    kill.WaitForExit();\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": "",
        "scriptInputVariables": [],
