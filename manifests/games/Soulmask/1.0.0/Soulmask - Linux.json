        "name": "Save the world and shut down",
        "description": "Save the world and shut down",
        "code": "//refAssemblies: System.Diagnostics.Process.dll\nusing System;\nusing System.Diagnostics;\nusing System.Net.Sockets;\nusing System.Text;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Graceful stop for Soulmask: send \"shutdown 1\" to the maintenance port (-EchoPort = the service's RCON\n// port, bound to 127.0.0.1), which saves the world and exits, then wait until the process is gone so the\n// panel's stop doesn't kill it mid-save. A big world can take minutes to write, hence the long wait.\nvar pid = ThisService.ProcessId;\nvar port = ThisService.RconPort;\nconst int maxWaitSeconds = 600;\n\nbool IsRunning(int id)\n{\n    try { using (var p = Process.GetProcessById(id)) return !p.HasExited; }\n    catch (ArgumentException) { return false; }\n    catch (InvalidOperationException) { return false; }\n}\n\nif (pid == null || pid <= 0 || !IsRunning(pid.Value))\n{\n    ScriptConsole.WriteLine((object)\"The server is not running; nothing to save.\");\n    return;\n}\n\ntry\n{\n    using (var client = new TcpClient())\n    {\n        var connect = client.ConnectAsync(\"127.0.0.1\", port);\n        if (await Task.WhenAny(connect, Task.Delay(5000)) != connect)\n            throw new Exception(\"timed out connecting to 127.0.0.1:\" + port);\n        await connect;\n        var stream = client.GetStream();\n        // Send at once: the server reads a new connection on its next tick and drops it when nothing has arrived yet.\n        var payload = Encoding.UTF8.GetBytes(\"shutdown 1\\r\\n\");\n        await stream.WriteAsync(payload, 0, payload.Length);\n        await stream.FlushAsync();\n        var buffer = new byte[4096];\n        var end = DateTime.UtcNow.AddSeconds(5);\n        var reply = \"\";\n        while (DateTime.UtcNow < end && reply.Length == 0)\n        {\n            if (stream.DataAvailable) reply = Encoding.UTF8.GetString(buffer, 0, stream.Read(buffer, 0, buffer.Length)).Trim();\n            else await Task.Delay(100);\n        }\n        ScriptConsole.WriteLine((object)(\"shutdown 1: \" + (reply.Length > 0 ? reply : \"(no reply)\")));\n    }\n}\ncatch (Exception ex)\n{\n    // Still loading, or the port is not open: the panel's own stop takes over.\n    ScriptConsole.WriteLine((object)(\"Could not send the shutdown command (\" + ex.Message + \"); the server is stopped without saving.\"));\n    return;\n}\n\nfor (var second = 1; second <= maxWaitSeconds; second++)\n{\n    await Task.Delay(1000, ThisCancellationToken);\n    if (!IsRunning(pid.Value))\n    {\n        ScriptConsole.WriteLine((object)(\"The world was saved and the server exited after \" + second + \" s.\"));\n        return;\n    }\n}\nScriptConsole.WriteLine((object)(\"The server did not exit within \" + maxWaitSeconds + \" s; the panel stops it now.\"));\n",
