        "name": "Soulmask console (telnet EchoPort)",
        "description": "Soulmask console (telnet EchoPort)",
        "code": "using System;\r\nusing System.IO;\r\nusing System.Net.Sockets;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\r\n\r\n// Soulmask console over the server's maintenance port (-EchoPort = the service's RCON port).\r\n// The server binds that port to 127.0.0.1 only and asks no password, so this runs on the service's own\r\n// host and always connects to loopback. Commands: help, save 1, shutdown <seconds>, lp, ...\r\n// (\"quit\" only closes this connection; \"shutdown <seconds>\" saves and exits).\r\nvar result = \"\";\r\ntry\r\n{\r\n    var address = \"127.0.0.1\";\r\n    var port = Globals.Variables.Parse<int>(\"Port\");\r\n    var command = (Globals.Variables.Parse<string>(\"Command\") ?? \"\").Trim();\r\n\r\n    using (var client = new System.Net.Sockets.TcpClient())\r\n    {\r\n        var connect = client.ConnectAsync(address, port);\r\n        if (await Task.WhenAny(connect, Task.Delay(5000)) != connect)\r\n            throw new Exception(\"Timed out connecting to \" + address + \":\" + port);\r\n        await connect;\r\n\r\n        var stream = client.GetStream();\r\n        var buffer = new byte[16384];\r\n        var output = new System.IO.MemoryStream();\r\n\r\n        // Send at once: the server reads a new connection on its next tick and drops it when nothing has arrived yet.\r\n        var payload = System.Text.Encoding.UTF8.GetBytes(command + \"\\r\\n\");\r\n        await stream.WriteAsync(payload, 0, payload.Length);\r\n        await stream.FlushAsync();\r\n\r\n        // Read until the server has been quiet for 2 s (8 s at most).\r\n        var hardEnd = DateTime.UtcNow.AddSeconds(8);\r\n        var lastData = DateTime.UtcNow;\r\n        while (DateTime.UtcNow < hardEnd && DateTime.UtcNow - lastData < TimeSpan.FromMilliseconds(2000))\r\n        {\r\n            if (stream.DataAvailable)\r\n            {\r\n                var n = stream.Read(buffer, 0, buffer.Length);\r\n                if (n <= 0) break;\r\n                output.Write(buffer, 0, n);\r\n                lastData = DateTime.UtcNow;\r\n            }\r\n            else\r\n            {\r\n                if (client.Client.Poll(0, System.Net.Sockets.SelectMode.SelectRead) && client.Client.Available == 0) break; // closed\r\n                await Task.Delay(50);\r\n            }\r\n        }\r\n\r\n        // Drop telnet IAC negotiation sequences (0xFF cmd opt) before decoding.\r\n        var raw = output.ToArray();\r\n        var clean = new System.IO.MemoryStream();\r\n        for (var i = 0; i < raw.Length; i++)\r\n        {\r\n            if (raw[i] == 0xFF && i + 1 < raw.Length)\r\n            {\r\n                var cmd = raw[i + 1];\r\n                if (cmd == 0xFF) { clean.WriteByte(0xFF); i++; }\r\n                else if (cmd >= 0xFB && cmd <= 0xFE) i += 2;\r\n                else i++;\r\n                continue;\r\n            }\r\n            clean.WriteByte(raw[i]);\r\n        }\r\n        result = System.Text.Encoding.UTF8.GetString(clean.ToArray()).Replace(\"\\r\\n\", \"\\n\").Trim();\r\n    }\r\n}\r\ncatch (Exception ex)\r\n{\r\n    result = \"Soulmask console error: \" + ex.Message;\r\n}\r\nGlobals.ReturnValue = result;\r\n",
