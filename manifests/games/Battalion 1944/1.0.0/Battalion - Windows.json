    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "Batch",
        "operatingSystem": [
          "Windows"
        ],
        "scriptEvents": [
          "BeforeServiceStarted"
        ],
        "name": "Copy Steam client libraries next to the server",
        "description": "Copy Steam client libraries next to the server",
        "code": "for %%f in (steamclient64.dll tier0_s64.dll vstdlib_s64.dll) do if exist \u0022%%f\u0022 copy /y \u0022%%f\u0022 \u0022Battalion\\Binaries\\Win64\\%%f\u0022 \u003Enul\r\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": false,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
        "logApiExecutions": false,
        "order": 0,
        "icon": null,
        "scriptInputVariables": [],
        "scriptRoles": [],
