  "gamesScripts": [
    {
      "script": {
        "allGames": false,
        "global": false,
        "scriptEngine": "CSharp",
        "operatingSystem": [
          "Linux"
        ],
        "scriptEvents": [
          "BeforeServiceStopped"
        ],
        "name": "Graceful stop",
        "description": "Asks the server to save and exit (SIGTERM) and waits for it.",
        "code": "//refAssemblies: System.Diagnostics.Process.dll\nusing System;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\nusing System.Threading.Tasks;\n\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\n\n// Graceful stop: the server saves and exits on a close request (taskkill without /f on Windows, SIGTERM on Linux),\n// which the panel\u0027s own stop does not send. Only the server binary of THIS service is signalled.\nvar root = Path.GetFullPath((string)ThisService.RootDirectory).TrimEnd(Path.DirectorySeparatorChar) \u002B Path.DirectorySeparatorChar;\nvar binary = \u0022CoreKeeperServer\u0022;\nconst int maxWaitSeconds = 120;\n\nList\u003Cint\u003E ServerPids()\n{\n    var pids = new List\u003Cint\u003E();\n    if (System.OperatingSystem.IsWindows())\n    {\n        foreach (var p in Process.GetProcessesByName(Path.GetFileNameWithoutExtension(binary)))\n        {\n            try { if (p.MainModule.FileName.StartsWith(root, StringComparison.OrdinalIgnoreCase)) pids.Add(p.Id); }\n            catch { } // exited meanwhile\n        }\n        return pids;\n    }\n    foreach (var dir in Directory.EnumerateDirectories(\u0022/proc\u0022))\n    {\n        if (!int.TryParse(Path.GetFileName(dir), out var pid)) continue;\n        try\n        {\n            var exe = new FileInfo(Path.Combine(dir, \u0022exe\u0022)).LinkTarget ?? \u0022\u0022;\n            if (exe.StartsWith(root, StringComparison.Ordinal) \u0026\u0026 Path.GetFileName(exe) == binary) pids.Add(pid);\n        }\n        catch { } // processes of other users, or gone meanwhile\n    }\n    return pids;\n}\n\nvar targets = ServerPids();\nif (targets.Count == 0)\n{\n    ScriptConsole.WriteLine((object)\u0022The server is not running.\u0022);\n    return;\n}\nforeach (var pid in targets)\n{\n    var signal = System.OperatingSystem.IsWindows()\n        ? new ProcessStartInfo(\u0022taskkill.exe\u0022, new[] { \u0022/pid\u0022, pid.ToString() })\n        : new ProcessStartInfo(\u0022kill\u0022, new[] { \u0022-TERM\u0022, pid.ToString() });\n    signal.UseShellExecute = false; signal.RedirectStandardOutput = true; signal.RedirectStandardError = true;\n    using (var process = Process.Start(signal)) process.WaitForExit();\n}\nScriptConsole.WriteLine((object)(\u0022Asked the server (\u0022 \u002B string.Join(\u0022, \u0022, targets) \u002B \u0022) to save and exit.\u0022));\nfor (var second = 1; second \u003C= maxWaitSeconds; second\u002B\u002B)\n{\n    await Task.Delay(1000, ThisCancellationToken);\n    if (ServerPids().Count == 0)\n    {\n        ScriptConsole.WriteLine((object)(\u0022The server exited after \u0022 \u002B second \u002B \u0022 s.\u0022));\n        return;\n    }\n}\nScriptConsole.WriteLine((object)(\u0022The server did not exit within \u0022 \u002B maxWaitSeconds \u002B \u0022 s; the panel stops it now.\u0022));\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
        "runInBackground": false,
        "inputTimeoutMinutes": 15,
        "maxConcurrentRuns": 1,
