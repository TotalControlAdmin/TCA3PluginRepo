        "code": "chmod +x Battalion/Binaries/Linux/BattalionServer-Linux-Shipping 2>/dev/null\nmkdir -p .steam/sdk64\nif [ -f linux64/steamclient.so ]; then cp -f linux64/steamclient.so .steam/sdk64/steamclient.so; fi\n# The Sentry crash handler needs libssl.so.1.1, which current distros no longer ship; the server hangs waiting for it.\nif [ -f Battalion/Plugins/Sentry/Binaries/Linux/crashpad_handler ]; then\n  mv -f Battalion/Plugins/Sentry/Binaries/Linux/crashpad_handler Battalion/Plugins/Sentry/Binaries/Linux/crashpad_handler.disabled\nfi\n",
