        "name": "Restore enshrouded_server.json",
        "description": "Restore enshrouded_server.json",
        "code": "@echo off\nsetlocal enabledelayedexpansion\n\nset \"ThisService_RootDirectory=%ThisService_RootDirectory%\"\nset \"targetFile=%ThisService_RootDirectory%\\enshrouded_server.json\"\nset \"backupFile=%ThisService_RootDirectory%\\enshrouded_server.json.backup\"\n\nif exist \"!backupFile!\" (\n    if exist \"!targetFile!\" (\n        del \"!targetFile!\"\n        echo Deleted existing !targetFile!\n    )\n    ren \"!backupFile!\" \"server.properties\"\n    echo Renamed !backupFile! to enshrouded_server.json\n) else (\n    echo !backupFile! not found in the specified directory.\n)\n\nendlocal\n",
        "runImpersonated": false,
        "stopService": false,
        "ignoreErrors": true,
