        "scriptEvents": [
          "BeforeCustomModUninstalled"
        ],
        "name": "Remove the Workshop mod from the mod list",
        "description": "Remove the Workshop mod from the mod list",
        "code": "//refAssemblies: TCAdmin.Web.Shared.dll\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.IO;\r\nusing System.Linq;\r\nusing System.Threading.Tasks;\r\nusing Microsoft.EntityFrameworkCore;\r\nusing TCAdmin.Web.Shared.Models;\r\n\r\nvar Globals = new TCAdmin.Scripting.Engines.Addons.CSharpGameGlobals(); // DO NOT MODIFY THIS LINE\r\n\r\n// Soulmask loads the Workshop items listed in -mod=\"id1,id2\" (the Mods variable). Remove this item from\r\n// the list and re-derive the command line; the change applies the next time the server starts.\r\n// The server also keeps its own copies: it downloads listed items into WS/Binaries/<platform>/steamapps\r\n// and installs each plugin folder into WS/Mods. Those are removed too so nothing stale is left behind.\r\nstring fileId = Convert.ToString(Dynamic.FileId).Trim();\r\n\r\nvar service = await GameServiceManager.GetAsync(ThisService.ServiceId);\r\nvar current = service.Variables ?? new TCAdminVars();\r\nvar mods = current.Parse<string>(\"Mods\", string.Empty)\r\n    .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)\r\n    .Select(x => x.Trim()).Where(x => x.Length > 0).ToList();\r\n\r\nif (!mods.Remove(fileId))\r\n{\r\n    ScriptConsole.WriteLine((object)$\"Workshop item {fileId} is not in the mod list.\");\r\n}\r\nelse\r\n{\r\n    var updated = new TCAdminVars();\r\n    foreach (var pair in current) updated[pair.Key] = pair.Value;\r\n    updated[\"Mods\"] = string.Join(\",\", mods);\r\n    service.Variables = updated;\r\n    GameServiceManager.TCAdminDbContext.Entry(service).State = EntityState.Modified;\r\n    await GameServiceManager.SaveChangesAsync(ThisCancellationToken);\r\n    ScriptConsole.WriteLine((object)(\"Mods=\" + updated[\"Mods\"]));\r\n}\r\n\r\n// Each installed plugin folder carries ModeInfo.json (UTF-16) with the Workshop id as \"ModID\".\r\nstring root = ThisService.RootDirectory;\r\nstring modsRoot = Path.Combine(root, \"WS\", \"Mods\");\r\nif (Directory.Exists(modsRoot))\r\n{\r\n    foreach (var dir in Directory.GetDirectories(modsRoot))\r\n    {\r\n        string info = Path.Combine(dir, \"ModeInfo.json\");\r\n        if (!File.Exists(info)) continue;\r\n        var match = System.Text.RegularExpressions.Regex.Match(File.ReadAllText(info), @\"\"\"ModID\"\"\\s*:\\s*\"\"?(\\d+)\");\r\n        if (!match.Success || match.Groups[1].Value != fileId) continue;\r\n        string name = Path.GetFileName(dir);\r\n        try { Directory.Delete(dir, true); ScriptConsole.WriteLine((object)(\"Removed WS/Mods/\" + name)); }\r\n        catch (Exception ex) { ScriptConsole.WriteLine((object)(\"Could not remove WS/Mods/\" + name + \" (\" + ex.Message + \"). Stop the server and delete it.\")); }\r\n    }\r\n}\r\nforeach (var platform in new[] { \"Win64\", \"Linux\" })\r\n{\r\n    string serverCopy = Path.Combine(root, \"WS\", \"Binaries\", platform, \"steamapps\", \"workshop\", \"content\", \"2646460\", fileId);\r\n    try { if (Directory.Exists(serverCopy)) { Directory.Delete(serverCopy, true); ScriptConsole.WriteLine((object)(\"Removed the server's download of \" + fileId)); } }\r\n    catch (Exception ex) { ScriptConsole.WriteLine((object)(\"Could not remove the server's download of \" + fileId + \" (\" + ex.Message + \").\")); }\r\n}\r\n\r\nvar refresh = await ServiceManager.RefreshActiveCommandLine(null, ThisService.ServiceId);\r\nScriptConsole.WriteLine((object)(string.IsNullOrEmpty(refresh.Error) ? \"Command line updated.\" : \"Command line not updated: \" + refresh.Error));\r\nScriptConsole.WriteLine((object)\"The mod is no longer loaded from the next server start.\");\r\n",
